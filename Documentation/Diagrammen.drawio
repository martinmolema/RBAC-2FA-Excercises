        <mxCell id="yPfbBpFBawgE4rTCZWUM-47" parent="yPfbBpFBawgE4rTCZWUM-1" style="whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#36393d;" value="Check Permissions" vertex="1">
          <mxGeometry height="60" width="120" x="400" y="1662" as="geometry" />
        </mxCell>
        <mxCell id="yPfbBpFBawgE4rTCZWUM-48" parent="yPfbBpFBawgE4rTCZWUM-1" style="text;html=1;strokeColor=#36393d;fillColor=#ffff88;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;Start&lt;/h1&gt;&lt;p&gt;De gebruiker navigeert naar een beveiligde website / pagina.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="15" y="232" as="geometry" />
        </mxCell>
        <mxCell id="yPfbBpFBawgE4rTCZWUM-50" parent="yPfbBpFBawgE4rTCZWUM-1" style="text;html=1;strokeColor=#36393d;fillColor=#ffff88;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;Website autorisatie&lt;/h1&gt;&lt;p&gt;Nu we weten dat de gebruiker bekend is, kunnen we kijken of deze gebruiker eigenlijk wel deze website mag gebruiken. We gebruikern hiervoor een speciale LDAP rol&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="270" x="529" y="1258" as="geometry" />
        </mxCell>
        <mxCell id="yPfbBpFBawgE4rTCZWUM-51" parent="yPfbBpFBawgE4rTCZWUM-1" style="text;html=1;strokeColor=#36393d;fillColor=#ffff88;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;Pagina autorisatie&lt;/h1&gt;&lt;p&gt;De gebruiker is bekend en mag deze website gebruiken. Nu kijken we naar de permissies die de rollen van de gebruiker opleveren. Die controleren we tegen de opgevraagde handeling en/of gegevens die aangevraagd wordt.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="270" x="57" y="1505" as="geometry" />
        </mxCell>
        <mxCell id="yPfbBpFBawgE4rTCZWUM-52" parent="yPfbBpFBawgE4rTCZWUM-1" style="text;html=1;strokeColor=#36393d;fillColor=#ffff88;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;Alles in orde&lt;/h1&gt;&lt;p&gt;We weten nu zeker dat de gebruiker deze website én de gevraagde web pagina mag gebruiken. De webserver zal de pagina aanbieden aan de webserver.&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="270" x="540" y="1942" as="geometry" />
        </mxCell>
